# Copia este archivo como .env.local y completa los valores.

# Contraseña del perfil Creadero (Administrador)
ADMIN_PASSWORD=
# Contraseña del perfil ALTIUS (Visualización). Si se deja vacía, ALTIUS entra sin contraseña.
ALTIUS_PASSWORD=

DATABASE_URL=

# Cloudflare R2 (documentos de facturas)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
